{% extends 'base.html.twig' %}

{% block title %}ChoufliDoc - Find your Doctor{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
{% endblock %}

{% block body %}
    <header class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 text-white">
                    <h1 class="display-4 fw-bold">Your mental health, our priority.</h1>
                    <p class="lead">Book an appointment with the best DR. Slimen Labyedh.</p>
                    
                    <div class="mt-4">
                        {% if app.user %}
                            <a href="#" class="btn btn-primary btn-lg">Search for a Doctor</a>
                        {% else %}
                            <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg">Get Started</a>
                            <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-lg ms-2">Login</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="features-section py-5">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4 mb-4">
                    <div class="feature-card p-4">
                        <i class="fas fa-user-md fa-3x mb-3 text-primary"></i>
                        <h3>Find a Doctor</h3>
                        <p>Access thousands of certified healthcare professionals.</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="feature-card p-4">
                        <i class="fas fa-calendar-check fa-3x mb-3 text-primary"></i>
                        <h3>Book Appointment</h3>
                        <p>Choose a time that works for you, 24/7.</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="feature-card p-4">
                        <i class="fas fa-notes-medical fa-3x mb-3 text-primary"></i>
                        <h3>Manage Health</h3>
                        <p>Keep track of your medical history and prescriptions.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}