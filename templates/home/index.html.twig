{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}
{% block stylesheets %}
    <link href="{{ asset('css/home.css') }}" rel="stylesheet">
{% endblock %}
{% block body %}
<main class="flex-shrink-0">

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white py-3">
        <div class="container px-5">
            <a class="navbar-brand" href="">
                <span class="fw-bolder text-primary">Choufli DOC</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 small fw-bolder">
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Login</a></li>
                    <li class="nav-item"><a class="nav-link" href="">About</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Header -->
    <header class="py-5">
        <div class="container px-5 pb-5">
            <div class="row gx-5 align-items-center">

                <!-- Text -->
                <div class="col-xxl-5 text-center text-xxl-start">

                    <div class="fs-3 fw-light text-muted">
                        I can help you fix your trauma
                    </div>

                    <h1 class="display-3 fw-bolder mb-5">
                        <span class="text-gradient d-inline">book an appointment now !</span>
                    </h1>

                    <div class="d-grid gap-3 d-sm-flex justify-content-sm-center justify-content-xxl-start">
                        <a class="btn btn-primary btn-lg px-5 py-3"
                           href="{{ path('app_register') }}">Register</a>

                        <a class="btn btn-outline-dark btn-lg px-5 py-3"
                           href="{{ path('app_login') }}">Login</a>
                    </div>
                </div>

                <!-- Profile Image -->
                <div class="col-xxl-7 text-center">
                    <div class="profile bg-gradient-primary-to-secondary mt-5 mt-xxl-0">
                        <img class="profile-img"
                             src="{{ asset('images/slimen1.png') }}"
                             alt="Profile picture">
                    </div>
                </div>

            </div>
        </div>
    </header>

    <!-- About -->
    <section class="bg-light py-5">
        <div class="container px-5">
            <div class="row justify-content-center">
                <div class="col-xxl-8 text-center my-5">

                    <h2 class="display-5 fw-bolder">
                        <span class="text-gradient d-inline"> About us </span>
                    </h2>

                    <p class="lead fw-light mb-4">
                       A specialized practitioner focused on the diagnosis, treatment, and prevention of mental, emotional, and behavioral disorders. Utilizing evidence-based therapeutic techniques and clinical assessment, I work collaboratively with patients to develop personalized treatment plans that promote long-term psychological health and functional recovery.
                    </p>

                    <p class="text-muted">
                     Avenu hbib thameur, centre ville, tunis, immeuble Jannet arafa.
                    </p>

                    <div class="d-flex justify-content-center fs-2 gap-4">
                        <a class="text-gradient" href="#"><i class="bi bi-twitter"></i></a>
                        <a class="text-gradient" href="#"><i class="bi bi-facebook"></i></a>
                        <a class="text-gradient" href="#"><i class="bi bi-instagram"></i></a>
                    </div>

                </div>
            </div>
        </div>
    </section>

</main>

<!-- Footer -->
<footer class="bg-white py-4 mt-auto">
    <div class="container px-5">
       
    </div>
</footer>
{% endblock %}
