{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}
{% block stylesheets %}
<link href="{{ asset('css/home.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<main class="flex-shrink-0">

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white py-3">
        <div class="container px-5">
            <a class="navbar-brand" href="">
                <span class="fw-bolder text-primary">Choufli DOC</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 small fw-bolder">
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Login</a></li>
                    <li class="nav-item"><a class="nav-link" href="">About</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Header -->
    <header class="py-5">
        <div class="container px-5 pb-5">
            <div class="row gx-5 align-items-center">

                <!-- Text -->
                <div class="col-xxl-5 text-center text-xxl-start">

                    <div class="fs-3  text-muted">
                        <span class="fw-light"> You don’t have to face trauma alone</span>
                    </div>

                    <h1 class="display-3 fw-bolder mb-5">
                        <span class="text-gradient d-inline">Let’s begin your healing journey today</span>
                    </h1>

                    <div class="d-grid gap-3 d-sm-flex justify-content-sm-center justify-content-xxl-start">
                        <a class="btn btn-primary btn-lg px-5 py-3"
                           href="{{ path('app_register') }}">Register</a>

                        <a class="btn btn-outline-dark btn-lg px-5 py-3"
                           href="{{ path('app_login') }}">Login</a>
                    </div>
                </div>

                <!-- Profile Image -->
                <div class="col-xxl-7 text-center">
                    <div class="profile bg-gradient-primary-to-secondary mt-5 mt-xxl-0">
                        <img class="profile-img"
                             src="{{ asset('images/slimen1.png') }}"
                             alt="Profile picture">
                    </div>
                </div>

            </div>
        </div>
    </header>
<section class="bg-light py-5 about-section">
    <div class="container px-5">
        <div class="row justify-content-center align-items-center">
            <div class="col-lg-6 text-center my-5">
                <h2 class="display-5 fw-bolder">
                    <span class="text-gradient d-inline">About Us</span>
                </h2>
                <p class="lead fw-light mb-4">
                   Notre cabinet, situé au cœur de Tunis, offre un environnement chaleureux et confidentiel dédié à la santé mentale et au bien-être émotionnel. Nous proposons des consultations personnalisées, alliant expertise médicale et 
                   techniques thérapeutiques comme l’hypnose, pour accompagner chaque patient vers un mieux-être durable.
                <p class="text-muted">
                    Avenu hbib thameur, centre ville, tunis, immeuble Jannet arafa.
                </p>
            </div>

            
        </div>
    </div>
</section>
   <section class="bg-light py-5 about-section">
    <div class="container px-5">
        <div class="row justify-content-center align-items-center">
            <div class="col-lg-6 text-center my-5">
                <h2 class="display-5 fw-bolder">
                    <span class="text-gradient d-inline">DR Slimen Labyedh</span>
                </h2>
                <p class="lead fw-light mb-4">
                   Psychothérapeute et professeur diplômé de la Faculté de Médecine de Tunis, spécialisé 
                   dans la prise en charge thérapeutique par l’hypnose pour favoriser le bien-être mental et émotionnel.
                
            </div>

            <!-- Image column -->
            <div class="col-lg-6 text-center my-5">
                <img src="{{ asset('images/slimen2.png') }}" class="about-img"  />
            </div>
        </div>
    </div>
</section>


</main>

<!-- Footer -->
<footer class="bg-white py-4 mt-auto border-top">
    <div class="container px-5">
        <div class="row align-items-center justify-content-between">
            
            <!-- Logo / Cabinet Name -->
            <div class="col-md-4 text-center text-md-start mb-3 mb-md-0">
                <h5 class="fw-bold">Cabinet Psychothérapie Tunis</h5>
            </div>

            <!-- Contact Info -->
            <div class="col-md-4 text-center mb-3 mb-md-0">
                <p class="mb-1">📍 Avenu Hbib Thameur, Centre Ville, Tunis</p>
                <p class="mb-0">📞 +216 XX XXX XXX | ✉️ contact@cabinet.tn</p>
            </div>

            <!-- Social Media Icons -->
            <div class="col-md-4 text-center text-md-end">
                <a href="#" class="text-dark mx-2 fs-5"><i class="fab fa-facebook-f"></i></a>
                <a href="#" class="text-dark mx-2 fs-5"><i class="fab fa-instagram"></i></a>
                <a href="#" class="text-dark mx-2 fs-5"><i class="fab fa-linkedin-in"></i></a>
            </div>

        </div>

        <hr class="my-3">

        <div class="row">
            <div class="col text-center text-muted">
                &copy; {{ "now"|date("Y") }} Cabinet Psychothérapie Tunis. Tous droits réservés.
            </div>
        </div>
    </div>
</footer>

{% endblock %}
{% block javascripts %}
<script>
    window.addEventListener('scroll', function() {
        const image = document.querySelector('.about-img');
        const scrollTop = window.scrollY;
        const offset = 70; // max move in px
        // Move image down slowly as you scroll
        if(image){
            image.style.transform = `translateY(${Math.min(scrollTop / 5, offset)}px)`;
        }
    });
</script>
{% endblock %}

