                    </p>
                    <div class="doctor-features">
                        <div class="feature-item">
                            <i class="fas fa-graduation-cap text-primary me-3"></i>
                            <span>Professor at the Faculty of Medicine of Tunis</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-certificate text-primary me-3"></i>
                            <span>Specialized in Hypnotherapy</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-user-md text-primary me-3"></i>
                            <span>Expert in Psychotherapy</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Image à droite -->
            <div class="col-lg-6">
                <div class="about-image-wrapper">
                    <div class="about-image-container">
                        <img src="{{ asset('images/slimen2.png') }}" class="about-img" alt="Practice" />
                        <div class="image-decoration"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>


</main>

<!-- Footer -->
