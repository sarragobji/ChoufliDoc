{% extends 'base.html.twig' %}

{% block title %}Home - ChoufliDoc{% endblock %}
{% block stylesheets %}
<link href="{{ asset('css/home.css') }}" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" rel="stylesheet">

{% endblock %}



{% block body %}
<main class="flex-shrink-0">

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light fixed-top" id="mainNav">
        <div class="container px-5">
            <a class="navbar-brand" href="{{ path('app_home') }}">
                <span class="fw-bolder text-primary"><i class="fas fa-heartbeat me-2"></i>Choufli DOC</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 fw-semibold">
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                    <li class="nav-item"><a class="nav-link btn-login" href="{{ path('app_login') }}">Login</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Header / Hero Section -->
<header class="hero-section" id="hero">

    <!-- Background + overlay -->
    <div class="hero-background">
        <div class="hero-overlay"></div>
    </div>

    <!-- Content -->
    <div class="container px-5 pb-5">
        <div class="row gx-5 align-items-center min-vh-100">

            <!-- Text Content -->
            <div class="col-lg-6 text-center text-lg-start hero-content">

                <div class="hero-badge fade-in-up">
                    <i class="fas fa-heart me-2"></i>
                    <span>Welcome to ChoufliDoc</span>
                </div>

                <div class="fs-4 text-white-50 mb-3 fade-in-up delay-1">
                    <span class="fw-light">You don't have to face trauma alone</span>
                </div>

                <h1 class="display-2 fw-bolder mb-4 fade-in-up delay-2">
                    <span class="text-gradient d-inline">
                        Let's begin your healing journey today
                    </span>
                </h1>

                <p class="lead text-white-50 mb-5 fade-in-up delay-3">
                    Personalized care by experienced professionals for your mental
                    and emotional well-being.
                </p>

                <div class="d-flex flex-column flex-sm-row gap-3 fade-in-up delay-4">
                    <a href="{{ path('app_register') }}"
                       class="btn btn-primary btn-lg px-5 py-3 shadow-lg btn-hover">
                        <i class="fas fa-user-plus me-2"></i> Register
                    </a>

                    <a href="{{ path('app_login') }}"
                       class="btn btn-outline-light btn-lg px-5 py-3 btn-hover">
                        <i class="fas fa-sign-in-alt me-2"></i> Login
                    </a>
                </div>

            </div>

            <!-- Image -->
            <div class="col-lg-6 text-center hero-image-col">
                <div class="profile-container fade-in delay-5">
                    <div class="profile-circle">
                        <div class="profile-ring"></div>
                        <img
                            src="{{ asset('images/slimen1.png') }}"
                            alt="Dr. Slimen Labyedh"
                            class="profile-img img-fluid"
                        >
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator">
        <a href="#about" class="scroll-down">
            <i class="fas fa-chevron-down"></i>
        </a>
    </div>

</header>


    <!-- Services Section -->
    <section class="services-section py-5" id="services">
        <div class="container px-5">
            <div class="text-center mb-5 section-header">
                <h2 class="display-4 fw-bolder mb-3">
                    <span class="text-gradient">Our Services</span>
                </h2>
                <p class="lead text-muted">Solutions tailored to your needs</p>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="fas fa-brain"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Psychotherapy</h4>
                        <p class="text-muted">
                            Personalized therapeutic support for your mental 
                            and emotional well-being.
                        </p>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="fas fa-hypnosis"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Hypnotherapy</h4>
                        <p class="text-muted">
                            Therapeutic hypnosis techniques for ongoing support 
                            toward lasting well-being.
                        </p>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Online Consultations</h4>
                        <p class="text-muted">
                            Easily book appointments and follow your therapeutic 
                            journey remotely.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

 <!-- About Section -->
<section class="about-section py-5" id="about">
    <div class="container px-5">
        <div class="row justify-content-center align-items-center">
            <div class="col-lg-6 mb-5 mb-lg-0 text-center">
                <div class="about-content">
