{% extends 'base.html.twig' %}

{% block title %}My Dashboard - ChoufliDoc{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('css/Dashboard_user.css') }}" rel="stylesheet">
    <style>
        [data-theme="dark"] {
            --bg-primary: #1a1a2e;
            --bg-secondary: #16213e;
            --text-primary: #eaeaea;
            --text-secondary: #b8b8b8;
            --card-bg: #0f3460;
            --border-color: #2a2a3e;
        }
        [data-theme="dark"] .dashboard-container {
            background: var(--bg-primary);
            color: var(--text-primary);
        }
        [data-theme="dark"] .welcome-header {
            background: var(--bg-secondary);
        }
        [data-theme="dark"] .section-card {
            background: var(--card-bg);
            border-color: var(--border-color);
        }
        [data-theme="dark"] .stat-card {
            background: var(--card-bg);
        }
        .theme-toggle:hover {
            transform: scale(1.1);
        }
    </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    <!-- Theme Toggle Button -->
    <button class="theme-toggle" id="themeToggle" title="Toggle Dark/Light Mode" style="position: fixed; bottom: 2rem; right: 2rem; width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; color: white; font-size: 1.5rem; cursor: pointer; box-shadow: 0 5px 15px rgba(0,0,0,0.3); transition: transform 0.3s ease; z-index: 1000;">
        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
    </button>

    <!-- Welcome Header Section -->
    <div class="welcome-header">
    <a href="{{ path('app_user_profile') }}" class="btn btn-primary">
    <i class="bi bi-person-circle me-1"></i> View Profile
</a>
<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editProfileLabel">Edit Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        {{ form_start(profileForm) }}
            <div class="mb-3">
                {{ form_label(profileForm.firstName) }}
                {{ form_widget(profileForm.firstName, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="mb-3">
                {{ form_label(profileForm.lastName) }}
                {{ form_widget(profileForm.lastName, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="mb-3">
                {{ form_label(profileForm.email) }}
                {{ form_widget(profileForm.email, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="mb-3">
                {{ form_label(profileForm.phoneNumber) }}
                {{ form_widget(profileForm.phoneNumber, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="mb-3">
                {{ form_label(profileForm.address) }}
                {{ form_widget(profileForm.address, {'attr': {'class': 'form-control'}}) }}
            </div>
            <button class="btn btn-primary w-100">Save Changes</button>
        {{ form_end(profileForm) }}
      </div>
    </div>
  </div>
</div>

<!-- Button to trigger modal -->
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editProfileModal">
    <i class="bi bi-pencil-square me-1"></i> Edit Profile
</button>




        <div class="welcome-content">
            <div class="welcome-text">
                <h1 class="welcome-title">
                    <span class="greeting">Hello,</span>
                    <span class="user-name">{{ app.user.firstName }} {{ app.user.lastName }}</span>
                </h1>
                <p class="welcome-subtitle">Welcome back to your health dashboard</p>
            </div>
            <div class="header-actions">
                <a href="{{ path('app_home') }}" class="btn-action btn-home">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Home</span>
                </a>
                <a href="{{ path('appointment_request') }}" class="btn-action btn-primary-action">
                    <i class="bi bi-calendar-plus-fill"></i>
                    <span>Book Appointment</span>
                </a>
                <a href="{{ path('app_logout') }}" class="btn-action btn-logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </div>
        </div>
    </div>


    <!-- Stats Cards Section -->
    <div class="stats-grid">
        <div class="stat-card stat-card-primary" data-count="{{ allAppointments|default([])|length }}">
            <div class="stat-card-icon">
                <i class="bi bi-calendar-check-fill"></i>
            </div>
            <div class="stat-card-content">
                <h3 class="stat-card-label">Total Appointments</h3>
                <h2 class="stat-card-value" data-target="{{ allAppointments|default([])|length }}">{{ allAppointments|default([])|length }}</h2>
                <p class="stat-card-desc">Your scheduled appointments</p>
            </div>
            <div class="stat-card-decoration"></div>
        </div>

        <div class="stat-card stat-card-success" data-count="{{ medicalRecords|default([])|length }}">
            <div class="stat-card-icon">
                <i class="bi bi-file-earmark-medical-fill"></i>
            </div>
            <div class="stat-card-content">
                <h3 class="stat-card-label">Medical Records</h3>
                <h2 class="stat-card-value" data-target="{{ medicalRecords|default([])|length }}">{{ medicalRecords|default([])|length }}</h2>
                <p class="stat-card-desc">Your health records</p>
            </div>
            <div class="stat-card-decoration"></div>
        </div>
    </div>

    <!-- Appointments Section -->
    <div class="dashboard-section">
        <div class="section-header">
            <div class="section-title-wrapper">
                <div class="section-icon appointment-icon">
                    <i class="bi bi-calendar-event-fill"></i>
                </div>
                <div>
                    <h2 class="section-title">My Appointments</h2>
                    <p class="section-subtitle">Manage your upcoming appointments</p>
                </div>
            </div>
        </div>

        <div class="section-card">
            {% if appointments is empty %}
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="bi bi-calendar-x"></i>
                    </div>
                    <h3>No Appointments</h3>
                    <p>You don't have any appointments scheduled yet.</p>
                    <a href="{{ path('appointment_request') }}" class="btn btn-primary mt-3">
                        <i class="bi bi-plus-circle"></i> Book Your First Appointment
                    </a>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th><i class="bi bi-calendar3"></i> Date</th>
                                <th><i class="bi bi-person-badge"></i> Doctor</th>
                                <th><i class="bi bi-info-circle"></i> Status</th>
                                <th class="text-end"><i class="bi bi-gear"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for appointment in appointments %}
                                <tr class="table-row-modern">
                                    <td>
                                        <div class="date-cell">
                                            <span class="date-main">{{ appointment.dateAppointment|date('d M Y') }}</span>
                                            <span class="date-sub">{{ appointment.dateAppointment|date('l') }}</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="doctor-cell">
                                            <div class="doctor-avatar">
                                                <i class="bi bi-person-circle"></i>
                                            </div>
                                            <span>{{ appointment.doctor }}</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="status-badge status-{{ appointment.status }}">
                                            {% if appointment.status == 'pending' %}
                                                <i class="bi bi-clock-history"></i>
                                            {% elseif appointment.status == 'accepted' %}
                                                <i class="bi bi-check-circle"></i>
                                            {% else %}
                                                <i class="bi bi-x-circle"></i>
                                            {% endif %}
                                            {{ appointment.status|capitalize }}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        {% if appointment.status != 'rejected' %}
                                            <form method="post" 
                                                  action="{{ path('appointment_cancel', {id: appointment.idAppointment}) }}"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                                <button type="submit" class="btn-action-icon btn-danger-icon" title="Cancel Appointment">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        {% else %}
                                            <span class="text-muted small">Cancelled</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Medical Records Section -->
    <div class="dashboard-section">
        <div class="section-header">
            <div class="section-title-wrapper">
                <div class="section-icon record-icon">
                    <i class="bi bi-file-earmark-medical-fill"></i>
                </div>
                <div>
                    <h2 class="section-title">My Medical Records</h2>
                    <p class="section-subtitle">View your health history and records</p>
                </div>
            </div>
        </div>

        <div class="section-card">
            {% if medicalRecords is empty %}
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="bi bi-file-earmark-medical"></i>
                    </div>
                    <h3>No Medical Records</h3>
                    <p>Your medical records will appear here once available.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th><i class="bi bi-calendar3"></i> Date</th>
                                <th><i class="bi bi-clipboard-pulse"></i> Reason</th>
                                <th><i class="bi bi-heart-pulse"></i> Diagnosis</th>
                                <th><i class="bi bi-prescription"></i> Prescription</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for record in medicalRecords %}
                                <tr class="table-row-modern">
                                    <td>
                                        <div class="date-cell">
                                            <span class="date-main">{{ record.createdAt|date('d M Y') }}</span>
                                            <span class="date-sub">{{ record.createdAt|date('H:i') }}</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="reason-cell">
                                            {% if record.reason %}
                                                {{ record.reason }}
                                            {% else %}
                                                <span class="text-muted">Not specified</span>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td>
                                        <div class="diagnosis-cell">
                                            {% if record.diagnosis %}
                                                <span class="diagnosis-badge diagnosis-complete">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    {{ record.diagnosis|length > 50 ? record.diagnosis|slice(0, 50) ~ '...' : record.diagnosis }}
                                                </span>
                                            {% else %}
                                                <span class="diagnosis-badge diagnosis-pending">
                                                    <i class="bi bi-clock"></i>
                                                    Pending
                                                </span>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td>
                                        <div class="prescription-cell">
                                            {% if record.prescription %}
                                                <span class="prescription-badge prescription-complete">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    {{ record.prescription|length > 50 ? record.prescription|slice(0, 50) ~ '...' : record.prescription }}
                                                </span>
                                            {% else %}
                                                <span class="prescription-badge prescription-pending">
                                                    <i class="bi bi-clock"></i>
                                                    Pending
                                                </span>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    // Animate stat cards on load
    document.addEventListener('DOMContentLoaded', function() {
        // Count up animation for stats
        const statValues = document.querySelectorAll('.stat-card-value');
        
        const animateValue = (element, start, end, duration) => {
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                element.textContent = Math.floor(progress * (end - start) + start);
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                }
            };
            window.requestAnimationFrame(step);
        };

        statValues.forEach(stat => {
            const target = parseInt(stat.getAttribute('data-target')) || 0;
            const currentValue = parseInt(stat.textContent) || 0;
            if (target > 0 && currentValue === 0) {
                animateValue(stat, 0, target, 1000);
            } else if (target > 0) {
                stat.textContent = target;
            }
        });

        // Add fade-in animation to cards
        const cards = document.querySelectorAll('.stat-card, .section-card');
        cards.forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            setTimeout(() => {
                card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 100);
        });
    });
    // Theme Toggle
    const themeToggle = document.getElementById('themeToggle');
    const themeIcon = document.getElementById('themeIcon');
    const html = document.documentElement;

    // Load saved theme
    const savedTheme = localStorage.getItem('theme') || 'light';
    html.setAttribute('data-theme', savedTheme);
    updateThemeIcon(savedTheme);

    if (themeToggle) {
        themeToggle.addEventListener('click', () => {
            const currentTheme = html.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            updateThemeIcon(newTheme);
        });
    }

    function updateThemeIcon(theme) {
        if (themeIcon) {
            if (theme === 'dark') {
                themeIcon.className = 'bi bi-sun-fill';
            } else {
                themeIcon.className = 'bi bi-moon-stars-fill';
            }
        }
    }
});

</script>
{% endblock %}
