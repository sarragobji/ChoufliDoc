{% extends 'base.html.twig' %}

{% block title %}ChoufliDoc - Find your Doctor{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row align-items-center">
        <div class="col-lg-6">
            <h1 class="display-4 fw-bold">Your mental health, our priority.</h1>
            <p class="lead">Book an appointment with the best doctor and professor DR.Slimen Labyedh.</p>
            
            <div class="mt-4">
                {% if app.user %}
                    <a href="#" class="btn btn-primary btn-lg">Search for a Doctor</a>
                {% else %}
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg">Get Started</a>
                    <a href="{{ path('app_login') }}" class="btn btn-outline-secondary btn-lg ms-2">Login</a>
                {% endif %}
            </div>
        </div>
        <div class="col-lg-6 mt-4 mt-lg-0">
            <img src="{{ asset('images/chouflihalBackgroud.jpg') }}" class="img-fluid rounded shadow" >
        </div>
    </div>

    <hr class="my-5">

    <div class="row text-center">
        <div class="col-md-4">
            <h3>Find a Doctor</h3>
            <p>Access thousands of certified healthcare professionals.</p>
        </div>
        <div class="col-md-4">
            <h3>Book Appointment</h3>
            <p>Choose a time that works for you, 24/7.</p>
        </div>
        <div class="col-md-4">
            <h3>Manage Health</h3>
            <p>Keep track of your medical history and prescriptions.</p>
        </div>
    </div>
</div>
{% endblock %}