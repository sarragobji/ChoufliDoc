{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - ChoufliDoc{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('vendor/fontawesome-free/css/all.min.css') }}" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Nunito:300,400,600,700,800" rel="stylesheet">
    <link href="{{ asset('css/sb-admin-2.min.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div id="page-top">
<div id="wrapper">

    <!-- SIDEBAR -->
    <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion">

        <a class="sidebar-brand d-flex align-items-center justify-content-center"
           href="{{ path('admin') }}">
            <div class="sidebar-brand-text mx-3">ChoufliDoc</div>
        </a>

        <hr class="sidebar-divider my-0">

        <li class="nav-item active">
            <a class="nav-link" href="{{ path('admin') }}">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" href="{{ path('admin_appointment_index') }}">
                <i class="fas fa-calendar"></i>
                <span>Appointments</span>
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" href="{{ path('admin_user_index') }}">
                <i class="fas fa-users"></i>
                <span>Users</span>
            </a>
        </li>

        <hr class="sidebar-divider">
    </ul>
    <!-- END SIDEBAR -->

    <!-- CONTENT WRAPPER -->
    <div id="content-wrapper" class="d-flex flex-column">

        <!-- MAIN CONTENT -->
        <div id="content">

            <!-- TOPBAR -->
            <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 shadow">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item dropdown no-arrow">
                        <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown">
                            <span class="mr-2 text-gray-600 small">
                                {{ app.user.firstName }} {{ app.user.lastName }}
                            </span>
                            <img class="img-profile rounded-circle"
                                 src="{{ asset('img/undraw_profile.svg') }}">
                        </a>

                        <div class="dropdown-menu dropdown-menu-right shadow">
                            <a class="dropdown-item" href="{{ path('app_logout') }}">
                                <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2"></i>
                                Logout
                            </a>
                        </div>
                    </li>
                </ul>
            </nav>
            <!-- END TOPBAR -->

            <!-- PAGE CONTENT -->
            <div class="container-fluid">

                <h1 class="h3 mb-4 text-gray-800">Dashboard</h1>

                <!-- STAT CARDS -->
                <div class="row">

                    <div class="col-md-4 mb-4">
                        <div class="card border-left-primary shadow h-100 py-2">
                            <div class="card-body">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                    Patients
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    {{ patientsCount|default(0) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="card border-left-success shadow h-100 py-2">
                            <div class="card-body">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Appointments
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    {{ appointmentsCount|default(0) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="card border-left-info shadow h-100 py-2">
                            <div class="card-body">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                    Medical Records
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    {{ recordsCount|default(0) }}
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- DOCTOR CALENDAR -->
                {% if is_granted('ROLE_DOCTOR') %}
                    <div class="card shadow mb-4">
                        <div class="card-header py-3 d-flex justify-content-between align-items-center">
                            <h6 class="m-0 font-weight-bold text-primary">
                                Appointment Calendar
                            </h6>

                            <a href="{{ path('doctor_toggle_availability') }}"
                               class="btn btn-sm btn-{{ app.user.isAvailable ? 'success' : 'danger' }}">
                                {{ app.user.isAvailable ? 'Available' : 'Unavailable' }}
                            </a>
                        </div>

                        <div class="card-body">
                            <div id="calendar" style="min-height: 600px;"></div>
                        </div>
                    </div>
                {% endif %}

            </div>
            <!-- END PAGE CONTENT -->

        </div>
        <!-- END MAIN CONTENT -->

        <!-- FOOTER -->
        <footer class="sticky-footer bg-white">
            <div class="container my-auto text-center">
                <span>© 2026 ChoufliDoc</span>
            </div>
        </footer>

    </div>
    <!-- END CONTENT WRAPPER -->

</div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('vendor/jquery/jquery.min.js') }}"></script>
    <script src="{{ asset('vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('vendor/jquery-easing/jquery.easing.min.js') }}"></script>
    <script src="{{ asset('js/sb-admin-2.min.js') }}"></script>

    {% if is_granted('ROLE_DOCTOR') %}
        <script src="https://cdn.jsdelivr.net/npm/fullcalendar/index.global.min.js"></script>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const calendarEl = document.getElementById('calendar');

                const calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    height: 'auto',
                    nowIndicator: true,
                    events: {
                        url: '{{ path('doctor_calendar_events') }}',
                        failure: function () {
                            alert('Failed to load calendar events.');
                        }
                    }
                });

                calendar.render();
            });
        </script>
    {% endif %}
{% endblock %}
