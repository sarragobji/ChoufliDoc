{% extends 'base.html.twig' %}

{% block title %}Register - ChoufliDoc{% endblock %}

{% block stylesheets %}
<link href="{{ asset('css/login.css') }}" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-light fixed-top" id="mainNav">
    <div class="container px-5">
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <span class="fw-bolder text-primary"><i class="fas fa-heartbeat me-2"></i>Choufli DOC</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 fw-semibold">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                <li class="nav-item"><a class="nav-link btn-login" href="{{ path('app_register') }}">Register</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- Register Section -->
<section class="login-section">
    <div class="login-background"></div>
    <div class="login-overlay"></div>
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-xl-10 col-lg-12">
                <div class="login-card">
                    <div class="row g-0">
                        {# Image on the LEFT #}
                        <div class="col-lg-5 d-none d-lg-block login-image-col">
                            <div class="login-image-wrapper">
                                <img src="{{ asset('images/register.jpg') }}" class="login-image" alt="Register">
                                <div class="image-overlay-text">
                                    <h3>Start Your Health Journey</h3>
                                    <p>Join our community and take control of your well-being</p>
                                </div>
                            </div>
                        </div>

                        {# Form on the RIGHT #}
                        <div class="col-lg-7">
                            <div class="login-form-wrapper">
                                <div class="text-center mb-4">
                                    <h1 class="login-title">Create Account</h1>
                                    <p class="login-subtitle">Sign up to get started</p>
                                </div>
                                
                                {{ form_start(registrationForm, {'attr': {'class': 'login-form'}}) }}
                                    
                                    {# Row: Firstname & Lastname #}
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <div class="form-floating">
                                                {{ form_widget(registrationForm.firstname, {
                                                    'attr': {'class': 'form-control', 'placeholder': 'First Name'}
                                                }) }}
                                                <label><i class="fas fa-user me-2"></i>First Name</label>
                                                {{ form_errors(registrationForm.firstname) }}
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <div class="form-floating">
                                                {{ form_widget(registrationForm.lastname, {
                                                    'attr': {'class': 'form-control', 'placeholder': 'Last Name'}
                                                }) }}
                                                <label><i class="fas fa-user me-2"></i>Last Name</label>
                                                {{ form_errors(registrationForm.lastname) }}
                                            </div>
                                        </div>
                                    </div>

                                    {# Row: Email #}
                                    <div class="mb-3">
                                        <div class="form-floating">
                                            {{ form_widget(registrationForm.email, {
                                                'attr': {'class': 'form-control', 'placeholder': 'Email Address'}
                                            }) }}
                                            <label><i class="fas fa-envelope me-2"></i>Email Address</label>
                                            {{ form_errors(registrationForm.email) }}
                                        </div>
                                    </div>

                                    {# Row: Birthday & Phone Number #}
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <div class="form-floating">
                                                {{ form_widget(registrationForm.birthDate, {
                                                    'attr': {'class': 'form-control', 'placeholder': 'Date of Birth'}
                                                }) }}
                                                <label><i class="fas fa-calendar me-2"></i>Date of Birth</label>
                                                {{ form_errors(registrationForm.birthDate) }}
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <div class="form-floating">
                                                {{ form_widget(registrationForm.phoneNumber, {
                                                    'attr': {'class': 'form-control', 'placeholder': 'Phone Number'}
                                                }) }}
                                                <label><i class="fas fa-phone me-2"></i>Phone Number</label>
                                                {{ form_errors(registrationForm.phoneNumber) }}
                                            </div>
                                        </div>
                                    </div>

                                    {# Row: Address #}
                                    <div class="mb-3">
                                        <div class="form-floating">
                                            {{ form_widget(registrationForm.address, {
                                                'attr': {'class': 'form-control', 'placeholder': 'Full Address'}
                                            }) }}
                                            <label><i class="fas fa-map-marker-alt me-2"></i>Address</label>
                                            {{ form_errors(registrationForm.address) }}
                                        </div>
                                    </div>

                                    {# Row: Password #}
                                    <div class="mb-3">
                                        <div class="form-floating">
                                            {{ form_widget(registrationForm.plainPassword, {
                                                'attr': {'class': 'form-control', 'placeholder': 'Password'}
                                            }) }}
                                            <label><i class="fas fa-lock me-2"></i>Password</label>
                                            {{ form_errors(registrationForm.plainPassword) }}
                                        </div>
                                    </div>

                                    {# Agree Terms #}
                                    <div class="form-check mb-4">
                                        {{ form_widget(registrationForm.agreeTerms, {
                                            'attr': {'class': 'form-check-input'}
                                        }) }}
                                        <label class="form-check-label" for="{{ registrationForm.agreeTerms.vars.id }}">
                                            I agree to the <a href="#" class="text-link">Terms and Conditions</a>
                                        </label>
                                        {{ form_errors(registrationForm.agreeTerms) }}
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-login-submit w-100 mb-3">
                                        <i class="fas fa-user-plus me-2"></i>Create Account
                                    </button>
                                    
                                {{ form_end(registrationForm) }}

                                <hr class="my-4">
                                
                                <div class="text-center">
                                    <p class="mb-0 text-muted">Already have an account?</p>
                                    <a href="{{ path('app_login') }}" class="btn btn-outline-primary mt-2">
                                        <i class="fas fa-sign-in-alt me-2"></i>Sign In
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Navbar scroll effect
    const navbar = document.getElementById('mainNav');
    window.addEventListener('scroll', function() {
        if (window.scrollY > 50) {
            navbar.classList.add('scrolled');
        } else {
            navbar.classList.remove('scrolled');
        }
    });
});
</script>
{% endblock %}