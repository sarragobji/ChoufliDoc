{% extends 'base.html.twig' %}

{% block title %}Register - ChoufliDoc{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('vendor/fontawesome-free/css/all.min.css') }}" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="{{ asset('css/sb-admin-2.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="bg-gradient-primary vh-100">
    <div class="container">
        <div class="card o-hidden border-0 shadow-lg my-5">
            <div class="card-body p-0">
                <div class="row">
                {# Image on the left #}
                <div class="col-lg-5 d-none d-lg-block p-0">
                    <img src="{{ asset('images/register.jpg') }}" class="img-fluid w-100 h-100" >
                </div>

                {# Form on the right #}
                <div class="col-lg-7">
                    <div class="p-5">
                        <div class="text-center">
                            <h1 class="h4 text-gray-900 mb-4">Create an Account!</h1>
                        </div>
                            
                            {{ form_start(registrationForm, {'attr': {'class': 'user'}}) }}
                                
                                {# Row: Firstname & Lastname #}
                                <div class="form-group row">
                                    <div class="col-sm-6 mb-3 mb-sm-0">
                                        {{ form_widget(registrationForm.firstname, {
                                            'attr': {'class': 'form-control form-control-user', 'placeholder': 'First Name'}
                                        }) }}
                                        {{ form_errors(registrationForm.firstname) }}
                                    </div>
                                    <div class="col-sm-6">
                                        {{ form_widget(registrationForm.lastname, {
                                            'attr': {'class': 'form-control form-control-user', 'placeholder': 'Last Name'}
                                        }) }}
                                        {{ form_errors(registrationForm.lastname) }}
                                    </div>
                                </div>

                                {# Row: Email #}
                                <div class="form-group">
                                    {{ form_widget(registrationForm.email, {
                                        'attr': {'class': 'form-control form-control-user', 'placeholder': 'Email Address'}
                                    }) }}
                                    {{ form_errors(registrationForm.email) }}
                                </div>

                                {# Row: Birthday & Phone Number #}
                                <div class="form-group row">
                                    <div class="col-sm-6 mb-3 mb-sm-0">
                                        {{ form_widget(registrationForm.birthDate, {
                                            'attr': {'class': 'form-control form-control-user', 'placeholder': 'birthDate'}
                                        }) }}
                                        <small class="text-muted ml-3">Date of Birth</small>
                                        {{ form_errors(registrationForm.birthDate) }}
                                    </div>
                                    <div class="col-sm-6">
                                        {{ form_widget(registrationForm.phoneNumber, {
                                            'attr': {'class': 'form-control form-control-user', 'placeholder': 'Phone Number'}
                                        }) }}
                                        {{ form_errors(registrationForm.phoneNumber) }}
                                    </div>
                                </div>

                                {# Row: Address #}
                                <div class="form-group">
                                    {{ form_widget(registrationForm.address, {
                                        'attr': {'class': 'form-control form-control-user', 'placeholder': 'Full Address'}
                                    }) }}
                                    {{ form_errors(registrationForm.address) }}
                                </div>

                                {# Row: Password & Repeat #}
                                <div class="form-group row">
                                    <div class="col-sm-6 mb-3 mb-sm-0">
                                        {{ form_widget(registrationForm.plainPassword, {
                                            'attr': {'class': 'form-control form-control-user', 'placeholder': 'Password'}
                                        }) }}
                                        {{ form_errors(registrationForm.plainPassword) }}
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="password" class="form-control form-control-user" id="exampleRepeatPassword" placeholder="Repeat Password">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="custom-control custom-checkbox small">
                                        {{ form_widget(registrationForm.agreeTerms, {
                                            'attr': {'class': 'custom-control-input'}
                                        }) }}
                                        <label class="custom-control-label" for="{{ registrationForm.agreeTerms.vars.id }}">
                                            Agree to Terms and Conditions
                                        </label>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary btn-user btn-block">
                                    Register Account
                                </button>
                                
                            {{ form_end(registrationForm) }}

                            <hr>
                            <div class="text-center">
                                <a class="small" href="{{ path('app_login') }}">Already have an account? Login!</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('vendor/jquery/jquery.min.js') }}"></script>
    <script src="{{ asset('vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('vendor/jquery-easing/jquery.easing.min.js') }}"></script>
    <script src="{{ asset('js/sb-admin-2.min.js') }}"></script>
{% endblock %}